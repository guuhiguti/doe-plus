DATABASE_URL=postgresql+psycopg://postgres:<sua-senha>@localhost:5432/doeplus
SECRET_KEY=<gere-com-python -c "import secrets; print(secrets.token_hex(32))">
ADMIN_PASSWORD_HASH=<gere-com-python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('SUA_SENHA'))">
